# Cổng chạy máy chủ Express & Socket.IO
PORT=5000

# Supabase Dashboard > Connect > Transaction pooler (port 6543).
# Project ref và pooler host của project EduRef AI đã được điền sẵn.
# Mật khẩu có ký tự đặc biệt phải được percent-encode.
DATABASE_URL="postgresql://postgres.kzukklgnmdhirjjkngps:YOUR_PERCENT_ENCODED_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require&sslaccept=accept_invalid_certs"

# Supabase Dashboard > Connect > Session pooler (port 5432).
# Prisma CLI dùng URL này cho migration/db push; session pooler tương thích mạng IPv4.
DIRECT_URL="postgresql://postgres.kzukklgnmdhirjjkngps:YOUR_PERCENT_ENCODED_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&sslaccept=accept_invalid_certs"

# Mã bí mật JWT xác thực phiên đăng nhập
JWT_SECRET=eduref_jwt_secret_hackathon_2026_super_secure_key

# Khóa Google Gemini API (Hỗ trợ 1 hoặc nhiều key cách nhau bằng dấu phẩy để hệ thống tự động xoay tua)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Tên mô hình Gemini sử dụng
GEMINI_MODEL=gemini-flash-lite-latest

# Địa chỉ Frontend cho phép kết nối qua CORS
FRONTEND_URL=http://localhost:5173

# Seed demo xóa dữ liệu hiện có. Chỉ bật trên project Supabase demo/disposable.
ALLOW_DESTRUCTIVE_SEED=false
